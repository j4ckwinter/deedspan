{
  "name": "short-stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "npm run build:sdk && tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts --production",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "scenario:run": "node --import tsx scripts/run-scenario.ts",
    "build:sdk": "tsc -p tsconfig.sdk.json",
    "prepack": "npm run build:sdk",
    "test:package": "node scripts/test-package.mjs",
    "predev": "npm run build:sdk",
    "pretypecheck": "npm run build:sdk",
    "pretest": "npm run build:sdk",
    "pretest:e2e": "npm run build:sdk",
    "prescenario:run": "npm run build:sdk",
    "example:agent": "node --env-file-if-exists=.env --import tsx scripts/run-drafts-agent.ts",
    "preexample:agent": "npm run build:sdk",
    "example:install": "node scripts/install-example.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "express": "5.3.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.5"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "description": "Expose application actions to agents with validation, authorization hooks, and execution traces.",
  "files": [
    "lib"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./react": {
      "types": "./lib/react.d.ts",
      "import": "./lib/react.js"
    }
  },
  "peerDependencies": {
    "react": ">=19 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
